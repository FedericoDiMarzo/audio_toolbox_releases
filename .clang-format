# ─────────────────────────────────────────────────────────────────────────────
#  .clang-format  —  Based on LLVM, tuned for legibility
#  Generated for: 4-space indentation, 120-column limit
# ─────────────────────────────────────────────────────────────────────────────

Language:        Cpp
BasedOnStyle:    LLVM

# ── Column & line width ───────────────────────────────────────────────────────
ColumnLimit:     120

# ── Indentation ───────────────────────────────────────────────────────────────
IndentWidth:                  4
ContinuationIndentWidth:      4
TabWidth:                     4
UseTab:                       Never

# Namespace bodies are NOT indented (avoids deep nesting)
NamespaceIndentation:         None
IndentExternBlock:            NoIndent

# Case labels indented inside switch
IndentCaseLabels:             true

# PP directives indented for readability
IndentPPDirectives:           BeforeHash

# ── Braces & blocks ───────────────────────────────────────────────────────────
BreakBeforeBraces:            Allman     # Every { on its own line — maximally legible
BraceWrapping:
  AfterClass:                 true
  AfterControlStatement:      Always
  AfterEnum:                  true
  AfterFunction:              true
  AfterNamespace:             true
  AfterStruct:                true
  AfterUnion:                 true
  BeforeCatch:                true
  BeforeElse:                 true
  IndentBraces:               false
  SplitEmptyFunction:         false
  SplitEmptyRecord:           false
  SplitEmptyNamespace:        false

# ── Spaces ────────────────────────────────────────────────────────────────────
SpaceBeforeParens:            ControlStatements   # if (…) not if(…)
SpaceInEmptyParentheses:      false
SpacesInParentheses:          false
SpacesInSquareBrackets:       false
SpacesInAngles:               false
SpaceAfterCStyleCast:         false
SpaceBeforeAssignmentOperators: true
SpaceBeforeRangeBasedForLoopColon: true
SpaceAfterLogicalNot:         false
SpaceBeforeSquareBrackets:    false

# ── Alignment ─────────────────────────────────────────────────────────────────
AlignConsecutiveAssignments:
  Enabled:          false

AlignConsecutiveDeclarations:
  Enabled:          false   # can get noisy; enable if you like aligned decls

AlignConsecutiveMacros:
  Enabled:          true
  AcrossEmptyLines: false
  AcrossComments:   false

AlignTrailingComments:        true
AlignOperands:                Align
AlignArrayOfStructures:       Right

# ── Pointer & reference style ─────────────────────────────────────────────────
PointerAlignment:             Left     # int* p, not int *p
ReferenceAlignment:           Left     # int& r

# ── Breaking long lines ───────────────────────────────────────────────────────
AllowShortBlocksOnASingleLine:       Never
AllowShortCaseLabelsOnASingleLine:   false
AllowShortFunctionsOnASingleLine:    Empty      # only truly empty {}
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine:        false
AllowShortLambdasOnASingleLine:      Inline

BreakBeforeBinaryOperators:    None
BreakBeforeTernaryOperators:   true
BreakConstructorInitializers:  BeforeColon
BreakInheritanceList:          BeforeColon
BreakStringLiterals:           true

# Constructor initialiser list — one item per line when it doesn't fit
PackConstructorInitializers:  Never
ConstructorInitializerIndentWidth: 4

# ── Function arguments & parameters ──────────────────────────────────────────
# Each argument/parameter on its own line.
# When a call doesn't fit on one line, every arg gets its own line (no bin-packing).
BinPackArguments:                          false
BinPackParameters:                         false
AllowAllArgumentsOnNextLine:               false
AllowAllParametersOfDeclarationOnNextLine: false

# ── Template & requires ───────────────────────────────────────────────────────
AlwaysBreakTemplateDeclarations: Yes

# ── Empty lines ───────────────────────────────────────────────────────────────
MaxEmptyLinesToKeep:            2
EmptyLineBeforeAccessModifier:  LogicalBlock   # blank line before public:/private:
EmptyLineAfterAccessModifier:   Never
SeparateDefinitionBlocks: Always

# ── Misc legibility ───────────────────────────────────────────────────────────
KeepEmptyLinesAtTheStartOfBlocks: false
ReflowComments:               true
FixNamespaceComments:         true    # adds  // namespace Foo  after closing }
SortUsingDeclarations:        true
Cpp11BracedListStyle:         false   # keeps spaces inside { init lists }
